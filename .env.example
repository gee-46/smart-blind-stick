# Copy this file to .env and adjust as needed.

# Database connection string.
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./smart_blind_stick.db
# PostgreSQL (for later):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smart_blind_stick

# Environment name
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Seconds since last check-in before a device is considered offline
DEVICE_OFFLINE_AFTER_SECONDS=60

# Default page sizes
DEFAULT_EVENT_LIMIT=50
DEFAULT_LOCATION_HISTORY_LIMIT=50

# Simulator settings (used by scripts/simulate_device.py)
SIMULATOR_BASE_URL=http://127.0.0.1:8000
SIMULATOR_DEVICE_ID=STICK_001
SIMULATOR_INTERVAL_SECONDS=5
