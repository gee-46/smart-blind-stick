# ==============================================================================
# DrishtiGuard Environment Configuration Example
# Copy this file to .env and configure for your local/production deployment.
# ==============================================================================

# Database connection string (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./smart_blind_stick.db

# Server Bindings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
RELOAD=false

# Offline threshold: seconds since last check-in before a stick is marked offline
DEVICE_OFFLINE_AFTER_SECONDS=30
HEARTBEAT_CHECK_INTERVAL_SECONDS=5

# Default query limits
DEFAULT_EVENT_LIMIT=50
DEFAULT_LOCATION_HISTORY_LIMIT=50

# JWT Authentication for Guardian Mobile App (Generate strong secret in production)
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Vision & YOLOv8n Companion Inference Service
AI_VISION_MODEL_PATH=models/yolov8n.pt
AI_VISION_CONFIDENCE_THRESHOLD=0.45
AI_VISION_DEVICE=cpu

# ESP32 Serial Hardware Bridge Settings (When testing via USB cable)
# Windows: COM3, COM4, etc. | Linux/Mac: /dev/ttyUSB0
HARDWARE_SERIAL_PORT=COM3
HARDWARE_BAUDRATE=115200
