# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env on your cloud server and customize secrets.
# ==============================================================================

# Server Environment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Persistent Storage & Database
# Option 1: SQLite on persistent mounted volume (e.g. Render Disk or Docker Volume)
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/smart_blind_stick.db

# Option 2: Managed PostgreSQL (Render Postgres, Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://user:secure_password@db-host:5432/smart_blind_stick

# Security: Generate a cryptographically secure 32+ byte string
# Example generation command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Device Telemetry & Liveness Monitoring
DEVICE_OFFLINE_AFTER_SECONDS=60
DEFAULT_EVENT_LIMIT=50
DEFAULT_LOCATION_HISTORY_LIMIT=50

# Fall Detection Subsystem Configuration
FALL_CONFIRMATION_TIMEOUT_SECONDS=20
FALL_ACCEL_FREE_FALL_THRESHOLD=0.6
FALL_ACCEL_IMPACT_THRESHOLD=2.4
FALL_TILT_THRESHOLD_DEGREES=40.0
FALL_IMMOBILITY_DURATION_SECONDS=2.5

# Guardian Notification Adapter (mock, log, sms, firebase)
NOTIFICATION_ADAPTER=mock
GUARDIAN_NAME=Primary Guardian
GUARDIAN_PHONE=+1-555-0199
GUARDIAN_EMAIL=guardian@example.com

# Optional Cloud AI Vision Weights Path
AI_VISION_MODEL_PATH=models/yolov8n.pt
AI_VISION_CONFIDENCE_THRESHOLD=0.45
AI_VISION_DEVICE=cpu
