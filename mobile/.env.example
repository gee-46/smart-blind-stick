# Copy this file to .env and set it to your FastAPI backend's address.
#
# For the Expo Go app / iOS simulator on the SAME machine as the backend:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
#
# For a PHYSICAL Android/iOS device on the same Wi-Fi/LAN as your dev
# machine (the normal case for testing against the real stick), you
# MUST use your computer's LAN IP -- localhost/127.0.0.1 on the phone
# means "the phone itself", not your computer:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
#
# Find your LAN IP with:
#   macOS/Linux: ifconfig | grep "inet "
#   Windows:     ipconfig
#
# For production, point this at your deployed backend's HTTPS URL:
#   EXPO_PUBLIC_API_URL=https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
